JWT_SECRET=change-me-to-a-long-random-string
SUPERADMIN_EMAILS=
# The first staff sign-in at /admin/login (staff ID + a password of 10+ characters). Change the password after.
SUPERADMIN_STAFF_ID=
SUPERADMIN_PASSWORD=
# Optional test customer for trying the site (user ID + password with a letter and a number). Leave empty on the live site.
TEST_USER_ID=
TEST_USER_PASSWORD=
# Mobile codes in production: your SMS provider's webhook gets POST {to, text} (bearer token optional).
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Optional: a Google Identity Services web client id turns on "Continue with Google".
GOOGLE_CLIENT_ID=
INTERNAL_KEY=change-me-to-another-long-random-string
# Card/UPI through Razorpay, for order payments and wallet top-ups. Leave empty to keep them off (wallet only).
# Add two webhooks in Razorpay with this secret:
#   https://<your domain>/api/orders/payments/razorpay/webhook (events payment.captured, refund.failed)
#   https://<your domain>/api/wallet/topup/razorpay/webhook (event payment.captured)
# Cancelled card/UPI orders are refunded through Razorpay's refunds API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX payouts for wallet withdrawals. Leave empty to pay withdrawals by hand (finance notes the UTR).
# Webhook URL: https://<your domain>/api/wallet/payouts/razorpayx/webhook (events payout.processed, payout.reversed,
# payout.failed, payout.rejected). The server's IP must be allowlisted in RazorpayX.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
# Encrypts Vault files and passwords. Changing it makes existing Vault data unreadable.
VAULT_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Turns on Pirento AI. Leave empty to keep the assistant off.
ANTHROPIC_API_KEY=
# Public domain for HTTPS (point its DNS A record at the server first).
DOMAIN=pirento.com
# Sign-in codes go out through this SMTP server, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=Pirento <no-reply@pirento.com>
# Decrypts Bharat ID KYC videos recorded before KYC moved to Digio. Changing it makes them unreadable.
KYC_ENCRYPTION_KEY=change-me-to-a-long-random-string
# The site's own address, used in emails that link back to it (Bharat ID for Business sign-in).
SITE_URL=https://pirento.com
# Digio runs Bharat ID's video KYC (with DigiLocker), the Aadhaar eSign of the declaration and its e-stamp.
# Keys from the Digio enterprise dashboard; DIGIO_ENV=production uses api.digio.in, anything else the sandbox.
# Register https://<your-domain>/api/identity/digio/webhook as the webhook, with DIGIO_WEBHOOK_SECRET as its secret.
DIGIO_ENV=sandbox
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_WEBHOOK_SECRET=
# The KYC workflow: VIDEO_KYC is Digio's standard one; or the name of one made in DigiStudio.
DIGIO_KYC_TEMPLATE=VIDEO_KYC
# A stamp tag from the Digio dashboard (E-Stamping) to e-stamp the declaration; empty signs it without a stamp.
DIGIO_ESTAMP_TAG=
# Encrypts documents attached to orders. Changing it makes stored documents unreadable.
ORDERS_FILE_KEY=change-me-to-a-long-random-string
